# NVIDIA GPU OCR — основная нагрузка на видеокарту (VRAM), web не дублирует CPU-OCR
#
#   cp .env.gpu.example .env
#   ./scripts/up_ocr.sh
#
# Проверка:
#   nvidia-smi
#   curl http://localhost:8081/health
#   → "device": "cuda:0", "gpu": {"name": "<ваша карта>", "vram_gb": ...}

WEB_PORT=8090
WEB_MEM_LIMIT=6g
WEB_MEM_RESERVATION=1536m
SURYA_MEM_LIMIT=10g
SURYA_MEM_RESERVATION=2g

PDF_LOCAL_ONLY=1
PDF_REPORT_LLM=0
PDF_VISION_MODE=off

# Surya на GPU = основной OCR для сканов/тайлов
PDF_OCR_ENGINE=surya
SURYA_OCR_URL=http://surya-ocr:8081
SURYA_OCR_TIMEOUT=420
SURYA_DEVICE=auto
SURYA_REQUIRE_GPU=0
SURYA_MAX_SIDE=2048
PDF_OCR_FALLBACK_TESS=1

# Offload тайлов на Surya GPU (не на CPU web). parallel=2 — VRAM без thrash
PDF_TILE_OCR_OFFLOAD=1
PDF_TILE_OCR_PARALLEL=2

# Searchable PDF: не гонять сетку по GPU зря (слой уже есть)
PDF_NORMATIVE_FORCE_OCR=0
PDF_TILE_TEXT_SKIP_OCR_MIN=80

PDF_GOST_CHECK_BUDGET=600
PDF_GOST_EXTRA_PER_PAGE_SEC=28
PDF_GOST_CHECK_BUDGET_MAX=14400
PDF_TILE_OCR_DPI=260

# 0 = проверять все найденные нормативы (без обрезки)
PDF_STN_MAX_REFS=0
